<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dunkles App-Theme -->
    <style name="AppTheme.Dark" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- AppCompat-Theme -->
    <style name="Theme.AppTheme.Dark" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="actionMenuTextColor">@color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Haupt-Theme der App -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:windowFullscreen">true</item>

        <!-- ⬇️ Wichtig für die Settings -->
        <item name="preferenceTheme">@style/CustomPreferenceStyle</item>
    </style>

    <!-- Dialog-Theme für Einstellungen -->
    <style name="AppTheme.SettingsDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="android:windowMinWidthMajor">50%</item>
        <item name="android:windowMinWidthMinor">50%</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
    </style>

    <!-- Transparentes Theme -->
    <style name="Theme.Transparent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- ✅ Benutzerdefinierter Preference-Stil -->
    <style name="CustomPreferenceStyle" parent="PreferenceThemeOverlay.v14.Material">
        <item name="preferenceScreenStyle">@style/CustomPreferenceScreenStyle</item>
    </style>

    <!-- Stil für die gesamte PreferenceScreen -->
    <style name="CustomPreferenceScreenStyle" parent="PreferenceThemeOverlay.v14.Material">
        <!-- Titel-Text -->
        <item name="android:titleTextAppearance">@style/CustomPreferenceTitleText</item>
        <!-- Summary-Text -->

    </style>

    <!-- Titel: Weiß, Fett, 18sp -->
    <style name="CustomPreferenceTitleText" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Summary: Hellgrau, 14sp -->
    <style name="CustomPreferenceSummaryText" parent="TextAppearance.AppCompat.Small">
        <item name="android:textColor">#CCCCCC</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Optional: Transparenter Dialog -->
    <style name="CustomDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- Dialoganimation -->
    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>

    <!-- Optional: NoActionBar Fullscreen Theme -->
    <style name="Theme.EasyTV.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
    </style>

</resources>
