package app.easytv.org;

import android.content.Intent;
import android.content.SharedPreferences;
import android.database.sqlite.SQLiteDatabase;
import android.os.Bundle;
import android.widget.Toast;

import androidx.annotation.Nullable;
import androidx.preference.EditTextPreference;
import androidx.preference.ListPreference;
import androidx.preference.Preference;
import androidx.preference.PreferenceFragmentCompat;

import java.io.File;

public class SettingsActivity extends androidx.appcompat.app.AppCompatActivity {
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        getSupportFragmentManager()
                .beginTransaction()
                .replace(android.R.id.content, new SettingsFragment())
                .commit();
    }

    public static class SettingsFragment extends PreferenceFragmentCompat
            implements SharedPreferences.OnSharedPreferenceChangeListener {

        @Override
        public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
            setPreferencesFromResource(R.xml.preferences, rootKey);


            SharedPreferences sharedPreferences =
                    requireContext().getSharedPreferences("app.easytv.org_preferences", MODE_PRIVATE);
            sharedPreferences.registerOnSharedPreferenceChangeListener(this);


            updateSummaries();


            Preference reloadPref = findPreference("btn_reload");
            if (reloadPref != null) {
                reloadPref.setOnPreferenceClickListener(preference -> {
                    Toast.makeText(getContext(), "Einstellungen neu geladen", Toast.LENGTH_SHORT).show();
                    requireActivity().recreate();
                    return true;
                });
            }


            Preference savePref = findPreference("btn_save");
            if (savePref != null) {
                savePref.setOnPreferenceClickListener(preference -> {
                    Toast.makeText(getContext(), "Einstellungen übernommen", Toast.LENGTH_SHORT).show();

                    String currentUrl = WebActivity.getWebInstance() != null
                            ? WebActivity.getWebInstance().webView.getUrl()
                            : "https://easy-tv.org";

                    Intent intent = new Intent(requireContext(), WebActivity.class);
                    intent.putExtra("url", currentUrl);
                    intent.addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP | Intent.FLAG_ACTIVITY_NEW_TASK);
                    startActivity(intent);
                    requireActivity().finish();
                    return true;
                });
            }


            Preference clearHistoryPref = findPreference("btn_clear_history");
            if (clearHistoryPref != null) {
                clearHistoryPref.setOnPreferenceClickListener(preference -> {
                    clearBrowserHistory();
                    Toast.makeText(getContext(), "Verlauf gelöscht", Toast.LENGTH_SHORT).show();
                    return true;
                });
            }
        }

        @Override
        public void onSharedPreferenceChanged(SharedPreferences prefs, String key) {
            updateSummaries();
        }

        private void clearBrowserHistory() {
            File dbFile = new File(requireContext().getFilesDir().getParent() + "/databases/easytv.db");

            if (!dbFile.exists()) {
                Toast.makeText(getContext(), "Datenbank nicht gefunden", Toast.LENGTH_SHORT).show();
                return;
            }

            SQLiteDatabase db = null;
            try {
                db = SQLiteDatabase.openDatabase(dbFile.getPath(), null, SQLiteDatabase.OPEN_READWRITE);
                db.execSQL("DELETE FROM history");
                Toast.makeText(getContext(), "Verlauf erfolgreich gelöscht", Toast.LENGTH_SHORT).show();
            } catch (Exception e) {
                Toast.makeText(getContext(), "Fehler beim Löschen: " + e.getMessage(), Toast.LENGTH_LONG).show();
                e.printStackTrace();
            } finally {
                if (db != null) db.close();
            }
        }

        private void updateSummaries() {
            EditTextPreference maxFav = findPreference("max_favorites");
            if (maxFav != null) maxFav.setSummary(maxFav.getText());

            EditTextPreference maxHist = findPreference("max_history");
            if (maxHist != null) maxHist.setSummary(maxHist.getText());

            EditTextPreference maxClip = findPreference("max_clipboard");
            if (maxClip != null) maxClip.setSummary(maxClip.getText());

            EditTextPreference remote = findPreference("remote_config");
            if (remote != null) remote.setSummary(remote.getText());

            EditTextPreference dlPath = findPreference("download_path");
            if (dlPath != null) dlPath.setSummary(dlPath.getText());

            ListPreference ua = findPreference("useragent");
            if (ua != null) ua.setSummary(ua.getEntry());
        }
    }
}
