    @Override
    public boolean onOptionsItemSelected(MenuItem item) {

        int id = item.getItemId();

        if (id == android.R.id.home) {
            if (drawerLayout.isDrawerOpen(GravityCompat.START)) {
                drawerLayout.closeDrawer(GravityCompat.START);
            } else {
                drawerLayout.openDrawer(GravityCompat.START);
            }
            return true;

        } else if (id == R.id.menu_copy) {
            copySelectedText();
            return true;
        } else if (id == R.id.list_past) {
            showClipboardPicker();
            return true;
        } else if (id == R.id.favorites) {
            addCurrentPageToFavorites();
            return true;
        } else if (id == R.id.full) {
            applyFullscreenFromPrefs();
            return true;
        } else if (id == R.id.option) {
            Settings();
            webView.loadUrl(webView.getUrl());
            return true;
        }
        return super.onOptionsItemSelected(item);
    }

    private List<String> loadClipboard() {
        List<String> list = new ArrayList<>();
        try (Cursor c = EasyTvDb.get(this).getClipboardDesc()) {
            int ix = c.getColumnIndexOrThrow("entry");
            while (c.moveToNext()) list.add(c.getString(ix));
        }
        return list;
    }

    private void showClipboardDialog() {
