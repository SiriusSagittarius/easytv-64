    @SuppressLint("GestureBackNavigation")
    @Override
    public void onBackPressed() {

        if (drawerLayout != null && drawerLayout.isDrawerOpen(GravityCompat.START)) {
            drawerLayout.closeDrawer(GravityCompat.START);
            return;
        }

        if (webView != null && webView.canGoBack()) {
            webView.goBack();
            Toast.makeText(this, "Zurück zur vorherigen Seite", Toast.LENGTH_SHORT).show();
            return;
        }

        long currentTime = System.currentTimeMillis();
        if (currentTime - lastBackPressTime < BACK_PRESS_INTERVAL) {
            super.onBackPressed();
        } else {
            Toast.makeText(this, "Nochmals Zurück drücken zum Beenden", Toast.LENGTH_SHORT).show();
            lastBackPressTime = currentTime;
        }
    }

    @Override
    public boolean onKeyLongPress(int keyCode, KeyEvent event) {
        if (keyCode == KEYCODE_BACK) {
            DrawerLayout drawerLayout = findViewById(R.id.drawer_layout);
            if (drawerLayout.isDrawerOpen(GravityCompat.START)) {
                drawerLayout.closeDrawer(GravityCompat.START);
            } else {
                drawerLayout.openDrawer(GravityCompat.START);
                drawerLayout.hasFocus();
            }
            return true;
        }
        return super.onKeyLongPress(keyCode, event);
    }

    protected void startupdate() {
        Intent intent = new Intent(this, UpdateActivity.class);
        startActivity(intent);
    }

    protected void startMainActivity() {
        finish();
    }

    private void restartActivity(String currentUrl) {
        Intent intent = getIntent();
        intent.putExtra("url", currentUrl);
        finish();
        startActivity(intent);
    }

    @Override
    protected void onDestroy() {
        super.onDestroy();
        if (wakeLock != null && wakeLock.isHeld()) {
            wakeLock.release();
        }
    }
