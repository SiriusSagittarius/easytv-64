    @Override
    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
        super.onActivityResult(requestCode, resultCode, data);


        if (requestCode == FILE_CHOOSER_REQUEST_CODE && filePathCallback != null) {
            Uri[] results = null;
            if (resultCode == Activity.RESULT_OK && data != null) {
                String dataString = data.getDataString();
                if (dataString != null) {
                    results = new Uri[]{Uri.parse(dataString)};
                } else if (data.getClipData() != null) {

                    ClipData clipData = data.getClipData();
                    results = new Uri[clipData.getItemCount()];
                    for (int i = 0; i < clipData.getItemCount(); i++) {
                        results[i] = clipData.getItemAt(i).getUri();
                    }
                } else if (data.getData() != null) {

                    results = new Uri[]{data.getData()};
                }
            }


            filePathCallback.onReceiveValue(results);
            filePathCallback = null;
            return;
        }


        if (requestCode == REQUEST_CODE_SAVE_FILE && resultCode == RESULT_OK && data != null) {
            Uri uri = data.getData();
            if (uri != null) {
                downloadToUri(downloadUrl, uri);
            }
        }
    }

    private void downloadToUri(String urlString, Uri destinationUri) {

        executor.execute(() -> {
            try {
                URL url = new URL(urlString);
                HttpURLConnection connection = (HttpURLConnection) url.openConnection();
                connection.connect();

                int totalSize = connection.getContentLength();
                int downloaded = 0;

                try (InputStream input = connection.getInputStream();
                     OutputStream output = getContentResolver().openOutputStream(destinationUri)) {

                    byte[] buffer = new byte[4096];
                    int bytesRead;

                    while ((bytesRead = input.read(buffer)) != -1) {
                        output.write(buffer, 0, bytesRead);
                        downloaded += bytesRead;
                        int progress = (int) ((downloaded / (float) totalSize) * 100);
                        updateProgress(progress);
                    }

                    runOnUiThread(() -> {
                        Toast.makeText(this, "Download abgeschlossen", Toast.LENGTH_SHORT).show();
                    });
                }

                connection.disconnect();
            } catch (IOException e) {
                e.printStackTrace();
                runOnUiThread(() -> {
                    Toast.makeText(this, "Fehler beim Download", Toast.LENGTH_SHORT).show();
                });
            }
        });
    }

    private void highlightText(String searchText) {
        String jsCode = "(function() {" +
                "var bodyText = document.body.innerHTML;" +
                "var searchText = '" + searchText + "';" +
                "var highlighted = '<span style=\"background-color:yellow;\">' + searchText + '</span>';" +
                "document.body.innerHTML = bodyText.split(searchText).join(highlighted);" +
                "})();";

        webView.evaluateJavascript(jsCode, null);
    }

    private static class WebAppInterface {
        Context mContext;

        WebAppInterface(Context c) {
            mContext = c;
        }

        @JavascriptInterface
        public void showSelectedText(String text) {

            handleCopy(text);
        }

        @JavascriptInterface
        public void onVideoDetected(String src) {
            if (mContext instanceof WebActivity) {
                ((WebActivity) mContext).onVideoDetected(src);
            }
        }

        private void handleCopy(String text) {
            if (text == null) return;
            text = text.trim();
            if (text.isEmpty()) return;


            ClipboardManager clipboard = (ClipboardManager) mContext.getSystemService(Context.CLIPBOARD_SERVICE);
            if (clipboard != null) {
                ClipData clip = ClipData.newPlainText("Copied Text", text);
                clipboard.setPrimaryClip(clip);
            }


            try {
                EasyTvDb.get(mContext).addClipboardEntry(text);
            } catch (Exception e) {
                android.util.Log.e("EasyTV", "Clipboard speichern fehlgeschlagen", e);
            }


            SharedPreferences prefs = mContext.getSharedPreferences("settings", Context.MODE_PRIVATE);
            prefs.edit()
                    .putString("email", text)
                    .apply();


            Toast.makeText(mContext, "Kopiert: " + text, Toast.LENGTH_SHORT).show();
        }
    }




    public void copySelectedText() {

        webView.evaluateJavascript(
                "(function() { return window.getSelection().toString(); })();",
                new ValueCallback<String>() {
                    @Override
                    public void onReceiveValue(String selectedText) {

                        if (selectedText != null && !selectedText.isEmpty()) {

                            selectedText = selectedText.replace("\"", "");

                            ClipboardManager clipboard = (ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE);
                            ClipData clip = ClipData.newPlainText("Kopierter Text", selectedText);
                            if (clipboard != null) {
                                clipboard.setPrimaryClip(clip);
                                try {
                                    EasyTvDb.get(WebActivity.this).addClipboardEntry(selectedText);
                                } catch (Exception e) {
                                    android.util.Log.e("EasyTV", "Clipboard speichern fehlgeschlagen", e);
                                }
                                Toast.makeText(WebActivity.this,
                                        "Text kopiert: " + selectedText,
                                        Toast.LENGTH_SHORT).show();
                            }
                        } else {
                            Toast.makeText(WebActivity.this,
                                    "Kein Text markiert",
                                    Toast.LENGTH_SHORT).show();
                        }
                    }
                }
        );
    }

    public void goBackInWebView() {
        if (webView != null && webView.canGoBack()) {
            webView.goBack();
            Toast.makeText(this, "Eine Seite zurück im WebView", Toast.LENGTH_SHORT).show();
        } else {
            Toast.makeText(this, "Keine Seite mehr im WebView-Verlauf", Toast.LENGTH_SHORT).show();
        }
    }

    public void scrollUpInWebView() {
        if (webView != null) {
            webView.scrollBy(0, -300);
        }
    }

    public void scrollDownInWebView() {
        if (webView != null) {
            webView.scrollBy(0, 300);
        }
    }

    public void goForwardInWebView() {
        if (webView != null && webView.canGoForward()) {
            webView.goForward();
            Toast.makeText(this, "Eine Seite vor im WebView", Toast.LENGTH_SHORT).show();
        } else {
            Toast.makeText(this, "Keine weitere Seite im WebView-Verlauf", Toast.LENGTH_SHORT).show();
        }
    }

    String pasteFromClipboard() {
        ClipboardManager clipboard = (ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE);
        if (clipboard != null && clipboard.hasPrimaryClip()) {
            ClipData clip = clipboard.getPrimaryClip();
            if (clip != null && clip.getItemCount() > 0) {
                ClipData.Item item = clip.getItemAt(0);
                return item.getText().toString();
            }
        }

        Toast.makeText(this, "Zwischenablage ist leer", Toast.LENGTH_SHORT).show();
        return "";
    }



    private void showClipboardPicker() {
        final ArrayList<Long> ids = new ArrayList<>();
        final ArrayList<String> entries = new ArrayList<>();
        try (Cursor c = EasyTvDb.get(this).getClipboardDesc()) {
            int ixId = c.getColumnIndexOrThrow("id");
            int ixEntry = c.getColumnIndexOrThrow("entry");
            while (c.moveToNext()) {
                ids.add(c.getLong(ixId));
                entries.add(c.getString(ixEntry));
            }
        }
        if (entries.isEmpty()) {
            Toast.makeText(this, "Leer", Toast.LENGTH_SHORT).show();
            return;
        }

        String[] arr = entries.toArray(new String[0]);
        new AlertDialog.Builder(this)
                .setTitle("Clipboard")
                .setItems(arr, (d, which) -> {
                    long selId = ids.get(which);
                    String selText = arr[which];
                    showClipboardActions(selId, selText);
                })
                .show();
    }

    private void showClipboardActions(long id, String text) {
        String[] ops = {"PASTE", "DELETE", "DELETE ALL"};
        new AlertDialog.Builder(this)
                .setTitle("Aktion")
                .setItems(ops, (d, w) -> {
                    switch (w) {
                        case 0:
                            insertTextIntoWebViewOrUrlBar(text);
                            break;
                        case 1:
                            EasyTvDb.get(this).deleteClipboardEntry(id);
                            Toast.makeText(this, "Eintrag gelöscht", Toast.LENGTH_SHORT).show();
                            break;
                        case 2:
                            new AlertDialog.Builder(this)
                                    .setTitle("Alle löschen")
                                    .setMessage("Gesamtes Clipboard leeren")
                                    .setPositiveButton("Löschen", (d2, w2) -> {
                                        EasyTvDb.get(this).clearClipboard();
                                        Toast.makeText(this, "Clipboard geleert", Toast.LENGTH_SHORT).show();
                                    })
                                    .setNegativeButton("Abbrechen", null)
                                    .show();
                            break;
                    }
                })
                .show();
    }

    private void insertTextIntoWebViewOrUrlBar(String text) {
        String safe = JSONObject.quote(text);
        String js =
                "(function(t){" +
                        "var a=document.activeElement;" +
                        "if(a && /^(INPUT|TEXTAREA)$/i.test(a.tagName)){" +
                        "a.value=t;return 'OK';}" +
                        "return 'NO';" +
                        "})(" + safe + ")";
        webView.evaluateJavascript(js, v -> {
            String res = jsonUnquote(v);
            if (!"OK".equals(res)) {
                pasteIntoUrlBar(text);
            }
        });
    }

    private void pasteIntoUrlBar(String text) {
        EditText urlBar = findViewById(R.id.urlInput);
        if (urlBar != null) {
            urlBar.setText(text);
            urlBar.setSelection(urlBar.getText().length());
            urlBar.requestFocus();
        } else {
            Toast.makeText(this, "Keine URL-Leiste gefunden", Toast.LENGTH_SHORT).show();
        }
    }

    private static String jsonUnquote(String v) {
        if (v == null) return null;
        try {
            return new JSONArray("[" + v + "]").getString(0);
        } catch (Exception ignore) {
            return v;
        }
    }

    @Override
    protected void onResume() {
        super.onResume();
        if (webView != null) {
            WebViewHelper.loadFromPrefsAndApply(this, webView);
        }

        closeIfExists(FavoritesList.class);
        closeIfExists(HistoryList.class);
    }

    private void closeIfExists(Class<?> activityClass) {
        try {
            for (android.app.Activity activity : ActivityTracker.getRunningActivities()) {
                if (activityClass.isInstance(activity) && !activity.isFinishing()) {
                    activity.finish();
                }
            }
        } catch (Exception ignored) {}
    }

    private void updateActionBar(String title, String url) {
        ActionBar actionBar = getSupportActionBar();
        if (actionBar != null) {
            actionBar.setDisplayShowCustomEnabled(true);

            LinearLayout layout = new LinearLayout(WebActivity.this);
            layout.setOrientation(LinearLayout.HORIZONTAL);
            layout.setLayoutParams(new ActionBar.LayoutParams(
                    ActionBar.LayoutParams.MATCH_PARENT,
                    ActionBar.LayoutParams.WRAP_CONTENT
            ));
            layout.setPadding(10, 0, 10, 0);

            goButton = createButton(R.drawable.ceh);
            favoriteButton = createButton(R.drawable.ic_favorite);
            helpButton = createButton(R.drawable.ic_help);
            searchButton = createButton(R.drawable.ic_search);
            downButton = createButton(R.drawable.ic_down);
            upButton = createButton(R.drawable.ic_up);

            urlInput = new EditText(WebActivity.this);
            urlInput.setLayoutParams(new LinearLayout.LayoutParams(
                    0,
                    LinearLayout.LayoutParams.MATCH_PARENT,
                    1f
            ));
            urlInput.setText(webView.getUrl() != null ? webView.getUrl() : "https://");
            urlInput.setSingleLine(true);
            urlInput.setTextColor(Color.WHITE);
            urlInput.setHintTextColor(Color.LTGRAY);
            urlInput.setBackgroundColor(Color.TRANSPARENT);
            urlInput.setInputType(InputType.TYPE_TEXT_VARIATION_URI);
            urlInput.setSelection(urlInput.getText().length());

            layout.addView(urlInput);
            layout.addView(goButton);
            layout.addView(favoriteButton);
            layout.addView(helpButton);
            layout.addView(searchButton);
            layout.addView(downButton);
            layout.addView(upButton);

            actionBar.setCustomView(layout);

            setupButtonActions();
        }
    }

    private ImageButton createButton(int drawableId) {
        ImageButton button = new ImageButton(WebActivity.this);
        button.setImageResource(drawableId);
        button.setBackgroundColor(Color.TRANSPARENT);
        button.setLayoutParams(new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.WRAP_CONTENT,
                LinearLayout.LayoutParams.MATCH_PARENT
        ));
        return button;
    }

    private void setupButtonActions() {

        setupButtonFocus(goButton);
        setupButtonFocus(favoriteButton);
        setupButtonFocus(helpButton);
        setupButtonFocus(searchButton);
        setupButtonFocus(downButton);
        setupButtonFocus(upButton);

        goButton.setOnClickListener(v -> {
            highlightButton(goButton);
            String enteredUrl = urlInput.getText().toString().trim();
            if (!enteredUrl.startsWith("http")) {
                enteredUrl = "https://" + enteredUrl;
            }
            webView.loadUrl(enteredUrl);
        });

        favoriteButton.setOnClickListener(v -> {
            highlightButton(favoriteButton);
            addCurrentPageToFavorites();
        });

        helpButton.setOnClickListener(v -> {
            highlightButton(helpButton);
            InfoActivity();
        });

        searchButton.setOnClickListener(v -> {
            highlightButton(searchButton);
            showSearchDialog();
        });

        downButton.setOnClickListener(v -> {
            highlightButton(downButton);
            scrollDown();
        });

        upButton.setOnClickListener(v -> {
            highlightButton(upButton);
            scrollUp();
        });
    }

    private void highlightButton(ImageButton activeButton) {

        goButton.setBackgroundColor(Color.TRANSPARENT);
        favoriteButton.setBackgroundColor(Color.TRANSPARENT);
        helpButton.setBackgroundColor(Color.TRANSPARENT);
        searchButton.setBackgroundColor(Color.TRANSPARENT);
        downButton.setBackgroundColor(Color.TRANSPARENT);
        upButton.setBackgroundColor(Color.TRANSPARENT);

        activeButton.setBackgroundColor(Color.BLACK);
    }

    private void setupButtonFocus(ImageButton button) {
        button.setBackgroundColor(Color.TRANSPARENT);

        button.setOnFocusChangeListener((v, hasFocus) -> {
            if (hasFocus) {
                button.setBackgroundColor(Color.parseColor("#000000"));
            } else {
                button.setBackgroundColor(Color.TRANSPARENT);
            }
        });
    }

    @SuppressLint("ResourceType")
    private void showPopup() {

        LayoutInflater inflater = getLayoutInflater();

        View popupView = inflater.inflate(R.menu.popup_layout, null);
        inputText = popupView.findViewById(R.id.inputText);
        AlertDialog.Builder builder = new AlertDialog.Builder(this, R.style.CustomDialogTheme);
        builder.setView(popupView);
        AlertDialog dialog = builder.create();

        EditText inputTextLocal = popupView.findViewById(R.id.inputText);
        Button submitButton = popupView.findViewById(R.id.submitButton);

        submitButton.setOnClickListener(v -> {
            String url1 = inputTextLocal.getText().toString();
            Toast.makeText(getApplicationContext(), "Eingabe: " + url1 + " wird geöffnet", Toast.LENGTH_SHORT).show();

            if (!url1.startsWith("http://") &&
                    !url1.startsWith("https://") &&
                    !url1.startsWith("view-source:https://") &&
                    !url1.startsWith("file:///")) {

                url1 = "https://" + url1;
            }

            webView.loadUrl(url1);
            dialog.dismiss();
        });

        dialog.setOnKeyListener((dialogInterface, keyCode, event) -> {
            if (event.getAction() == KeyEvent.ACTION_UP && keyCode == KeyEvent.KEYCODE_MENU) {
                showClipboardDialog();
                return true;
            }
            return false;
        });

        dialog.getWindow().getAttributes().windowAnimations = R.style.DialogAnimation;
        dialog.show();
    }



    public void addCurrentPageToFavorites() {
        String url = webView.getUrl();
        if (url == null || url.trim().isEmpty()) {
            Toast.makeText(this, "Keine URL", Toast.LENGTH_SHORT).show();
            return;
        }
        String title = webView.getTitle();
        String faviconUrl = url + "/favicon.ico";

        long row = EasyTvDb.get(this).insertFavoriteIfAbsent(faviconUrl, url, title);
        Toast.makeText(this,
                row == -1 ? "Favorit existiert" : "Favorit gespeichert",
                Toast.LENGTH_SHORT).show();
    }



    private void applyFullscreenFromPrefs() {
        SharedPreferences prefs = PreferenceManager.getDefaultSharedPreferences(this);
        boolean isFullscreenPref = prefs.getBoolean("fullscreen", false);

        if (isFullscreenPref) {
            getWindow().getDecorView().setSystemUiVisibility(
                    View.SYSTEM_UI_FLAG_FULLSCREEN
                            | View.SYSTEM_UI_FLAG_HIDE_NAVIGATION
                            | View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY
            );
        } else {
            getWindow().getDecorView().setSystemUiVisibility(
                    View.SYSTEM_UI_FLAG_VISIBLE
            );
        }
    }

