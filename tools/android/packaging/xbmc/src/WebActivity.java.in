    public void showSearchDialog() {

        final EditText searchInput = new EditText(this);
        AlertDialog.Builder dialog = new AlertDialog.Builder(this);
        dialog.setTitle("Wort Suchen");
        dialog.setMessage("Gib das Wort ein, das du auf der Seite suchen möchtest:");
        dialog.setView(searchInput);

        dialog.setPositiveButton("Suchen", (dialog1, which) -> {
            String searchText = searchInput.getText().toString().trim();
