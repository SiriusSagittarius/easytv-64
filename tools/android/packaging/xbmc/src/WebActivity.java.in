    @RequiresApi(api = VERSION_CODES.Q)
    @SuppressLint({"JavascriptInterface", "WrongViewCast", "ClickableViewAccessibility"})
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        SharedPreferences prefsApp = getSharedPreferences("app.easytv.org_preferences", MODE_PRIVATE);
        boolean mouseMode = prefsApp.getBoolean("mousemode", false);

        final int layout = mouseMode ? R.layout.activity_web_mouse : R.layout.activity_web_no_mouse;
        setContentView(layout);

        webView = findViewById(R.id.webView);

        Intent startIntent = getIntent();


        String extraUrl = startIntent.getStringExtra("url");
        String startUrl;
        if (extraUrl != null && !extraUrl.trim().isEmpty()) {
            startUrl = extraUrl.trim();
        } else if (Intent.ACTION_VIEW.equals(startIntent.getAction()) && startIntent.getData() != null) {
            startUrl = startIntent.getData().toString();
        } else {
            startUrl = "https://easy-tv.org";
        }



        WebViewHelper.loadFromPrefsAndApply(this, webView);
        settings = WebViewHelper.mapFromPrefs(
                getSharedPreferences("app.easytv.org_preferences", MODE_PRIVATE)
        );

        if (settings.adblock) {
            WebViewHelper.loadBlockList(this);
            blockList = WebViewHelper.getBlockList();
        }

        setupFireTVKeyboardControl();

        cursorLayout = findViewById(R.id.cursor_layout);
        cursorLayout.setWebView(webView);

        drawerLayout = findViewById(R.id.drawer_layout);
        navigationView = findViewById(R.id.navigation_view);
        tabContainer = findViewById(R.id.tabContainer);
        webviewContainer = findViewById(R.id.webviewContainer);
        View headerView = navigationView.getHeaderView(0);

        progressBar = headerView.findViewById(R.id.progressBar);

        WebSettings webSettings = webView.getSettings();
        webSettings.setJavaScriptEnabled(true);
        webSettings.setDomStorageEnabled(true);
        webSettings.setBuiltInZoomControls(true);
        webSettings.setDisplayZoomControls(false);
        webSettings.setAllowFileAccess(true);
        webSettings.setAllowContentAccess(true);
        webSettings.setAllowFileAccessFromFileURLs(true);
        webSettings.setAllowUniversalAccessFromFileURLs(true);
        webSettings.setCacheMode(WebSettings.LOAD_DEFAULT);
        webSettings.setMixedContentMode(WebSettings.MIXED_CONTENT_ALWAYS_ALLOW);
        webSettings.setUseWideViewPort(true);
        webSettings.setLoadWithOverviewMode(true);


        if (Build.VERSION.SDK_INT >= VERSION_CODES.S) {
            webView.getSettings().setSafeBrowsingEnabled(false);
        }
        webView.loadUrl(startUrl);

        webView.addJavascriptInterface(new Object() {
            @JavascriptInterface
            public void copyToClipboard(String text) {
                if (text == null) return;
                text = text.trim();
                if (text.isEmpty()) return;

                ClipboardManager clipboard = (ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE);
                ClipData clip = ClipData.newPlainText("kopiert", text);
                clipboard.setPrimaryClip(clip);
                Toast.makeText(WebActivity.this, "Kopiert: " + text, Toast.LENGTH_SHORT).show();

                try {
                    EasyTvDb.get(WebActivity.this).addClipboardEntry(text);
                } catch (Exception e) {
                    android.util.Log.e("EasyTV", "Fehler beim Speichern in DB", e);
                }
            }
        }, "EasyClipboard");

        drawerLayout.addDrawerListener(new DrawerLayout.DrawerListener() {
            @Override
            public void onDrawerSlide(View drawerView, float slideOffset) {}

            @Override
            public void onDrawerOpened(View drawerView) {
                Menu menu = navigationView.getMenu();
                if (menu != null && menu.size() > 0) {
                    MenuItem firstItem = menu.getItem(0);
                    navigationView.setCheckedItem(firstItem.getItemId());

                    navigationView.post(() -> {
                        View navItemView = navigationView.findViewById(firstItem.getItemId());
                        if (navItemView != null) {
                            navItemView.requestFocus();
                        }
                    });
                }
            }

            @Override
            public void onDrawerClosed(View drawerView) {}

            @Override
            public void onDrawerStateChanged(int newState) {}
        });

        navigationView.setNavigationItemSelectedListener(item -> {
            int id = item.getItemId();

            if (id == R.id.nav_homepage) {
                webView.loadUrl("https://easy-tv.org");
                return true;
            } else if (id == R.id.nav_open_url) {
                showPopup();
                item.setChecked(true);
                return true;
            } else if (id == R.id.nav_reload) {
                webView.loadUrl(webView.getUrl());
                Toast.makeText(this, "RELOAD", Toast.LENGTH_SHORT).show();
                return true;
            } else if (id == R.id.nav_favorites) {
                FavoritesList();
                return true;
            } else if (id == R.id.nav_history) {
                HistoryList();
                return true;
            } else if (id == R.id.nav_clean_cache) {
                ClearData.clearAll(this);
                Toast.makeText(this, "Daten wurden gelöscht", Toast.LENGTH_SHORT).show();
                return true;
            } else if (id == R.id.nav_downloads) {
                DownloadList();
                return true;
            } else if (id == R.id.nav_update_check) {
                startupdate();
                return true;
            } else if (id == R.id.nav_quit) {
                startMainActivity();
            }
            drawerLayout.closeDrawers();
            return true;
        });

        Intent intentView = getIntent();
        String action = intentView.getAction();
        Uri data = intentView.getData();
        if (Intent.ACTION_VIEW.equals(action) && data != null) {
            String url = data.toString();
            webView.loadUrl(url);
        }

        instance = this;

        CookieManager cookieManager = CookieManager.getInstance();
        cookieManager.setAcceptCookie(true);
        cookieManager.setAcceptThirdPartyCookies(webView, true);

        getWindow().setFlags(
                WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED,
                WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED
        );

        webView.evaluateJavascript(
                "(function() {" +
                        "   document.addEventListener('mousemove', function(event) {" +
                        "       const x = event.clientX;" +
                        "       const y = event.clientY;" +
                        "       const element = document.elementFromPoint(x, y);" +
                        "       if (element) {" +
                        "           console.log('Element unter dem Cursor:', element);" +
                        "       }" +
                        "   });" +
                        "})()", null);

        ActionBar actionBar = getSupportActionBar();
        if (actionBar != null) {
            actionBar.setBackgroundDrawable(new ColorDrawable(Color.parseColor("#036967")));
            getSupportActionBar().setDisplayHomeAsUpEnabled(true);
            getSupportActionBar().setDisplayShowHomeEnabled(true);
        }

        webView.setOnTouchListener((v, event) -> {
            if (event.getAction() == MotionEvent.ACTION_DOWN) {
                userClickedLink = true;
            }
            return false;
        });

        clipboardManager = (ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE);

        if (ContextCompat.checkSelfPermission(this, Manifest.permission.WRITE_EXTERNAL_STORAGE)
                != PackageManager.PERMISSION_GRANTED) {

            ActivityCompat.requestPermissions(this,
                    new String[]{Manifest.permission.WRITE_EXTERNAL_STORAGE}, 1);
        }

        webView.setHapticFeedbackEnabled(true);

        webView.setDownloadListener((url, userAgent, contentDisposition, mimetype, contentLength) -> {
            String fileName = URLUtil.guessFileName(url, contentDisposition, mimetype);
            startFileDownload(url, fileName, contentDisposition, mimetype, userAgent);
        });

        webView.setWebChromeClient(new WebChromeClient() {

            // NEU: Methode für Datei-Uploads (Android 5.0+)
            @RequiresApi(api = VERSION_CODES.LOLLIPOP)
            @Override
            public boolean onShowFileChooser(WebView webView,
                                             ValueCallback<Uri[]> filePathCallback,
                                             FileChooserParams fileChooserParams) {
                // Speichere das Callback für die spätere Verwendung in onActivityResult
                WebActivity.this.filePathCallback = filePathCallback;

                Intent intent = fileChooserParams.createIntent();
                intent.addCategory(Intent.CATEGORY_OPENABLE);

                try {
                    startActivityForResult(intent, FILE_CHOOSER_REQUEST_CODE);
                } catch (ActivityNotFoundException e) {
                    // Fehler beim Starten der Intent: Callback auf Null setzen
                    WebActivity.this.filePathCallback = null;
                    filePathCallback.onReceiveValue(null);
                    return false;
                }
                return true;
            }

            @Override
            public void onProgressChanged(WebView view, int newProgress) {
                if (newProgress == 100 && progressBar != null) {
                    progressBar.setVisibility(View.GONE);
                }
            }

            private View customView;
            private WebChromeClient.CustomViewCallback customViewCallback;

            @Override
            public void onShowCustomView(View view, CustomViewCallback callback) {
                if (customView != null) {
                    onHideCustomView();
                    return;
                }
                customView = view;
                customViewCallback = callback;
                if (webviewContainer != null) {
                    webviewContainer.addView(view);
                }
                if (webView != null) {
                    webView.setVisibility(View.GONE);
                }
                onVideoDetected("Fullscreen Video");
            }

            @Override
            public void onHideCustomView() {
                if (customView == null) return;
                if (webviewContainer != null) {
                    webviewContainer.removeView(customView);
                }
                if (webView != null) {
                    webView.setVisibility(View.VISIBLE);
                }
                if (customViewCallback != null) {
                    customViewCallback.onCustomViewHidden();
                }
                customView = null;
                customViewCallback = null;
            }
        });


        webView.addJavascriptInterface(new WebAppInterface(this), "AndroidInterface");

        webView.setWebViewClient(new WebViewClient() {

            @Override
            public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
                String reqUrl = request.getUrl().toString();
                String lowerUrl = reqUrl.toLowerCase(Locale.ROOT);

                if (strictShieldEnabled) {
                    try {
                        String currentHost = view.getUrl() != null ? Uri.parse(view.getUrl()).getHost() : null;
                        String targetHost = Uri.parse(reqUrl).getHost();
                        if (currentHost != null && targetHost != null && !targetHost.equalsIgnoreCase(currentHost)) {
                            if (!userClickedLink && !lowerUrl.contains("login") && !lowerUrl.contains("auth") && !lowerUrl.contains("oauth")) {
                                Toast.makeText(WebActivity.this, "PopUp / Umleitung blockiert: " + targetHost, Toast.LENGTH_SHORT).show();
                                return true;
                            }
                        }
                    } catch (Exception ignored) {}
                }

                if (lowerUrl.endsWith(".pdf") || lowerUrl.endsWith(".doc") || lowerUrl.endsWith(".docx") ||
                        lowerUrl.endsWith(".xls") || lowerUrl.endsWith(".xlsx") || lowerUrl.endsWith(".ppt") ||
                        lowerUrl.endsWith(".pptx") || lowerUrl.endsWith(".zip") || lowerUrl.endsWith(".rar") ||
                        lowerUrl.endsWith(".mp3") || lowerUrl.endsWith(".mp4") || lowerUrl.endsWith(".avi") ||
                        lowerUrl.endsWith(".jpg") || lowerUrl.endsWith(".jpeg") || lowerUrl.endsWith(".png") ||
                        lowerUrl.endsWith(".gif") || lowerUrl.endsWith(".txt") || lowerUrl.endsWith(".json") ||
                        lowerUrl.endsWith(".apk") || lowerUrl.contains("/download/file.php") ||
                        lowerUrl.contains("file.php?id=")) {

                    String fileName = URLUtil.guessFileName(reqUrl, null, null);
                    startFileDownload(reqUrl, fileName, null, null, webView.getSettings().getUserAgentString());
                    return true;
                }
                userClickedLink = true;
                return false;
            }

            @Override
            public WebResourceResponse shouldInterceptRequest(WebView view, WebResourceRequest request) {

                if (!settings.adblock) {
                    return super.shouldInterceptRequest(view, request);
                }

                String u = request.getUrl().toString();

                for (String blocked : WebViewHelper.getBlockList()) {
                    if (u.startsWith(blocked)) {
                        return new WebResourceResponse(
                                "text/plain",
                                "utf-8",
                                new ByteArrayInputStream("".getBytes())
                        );
                    }
                }

                return super.shouldInterceptRequest(view, request);
            }

            @Override
            public void onPageStarted(WebView view, String u, Bitmap favicon) {
                if (progressBar != null) {
                    progressBar.setVisibility(View.VISIBLE);
                }
                super.onPageStarted(view, u, favicon);
            }

            @Override
            public void onPageFinished(WebView view, String u) {
                super.onPageFinished(view, u);

                updateActionBar(view.getTitle(), u);
                writeUrlToHistory(u);
                if (progressBar != null) {
                    progressBar.setVisibility(View.GONE);
                }
                setTitle(u);
                if (u.contains("10minutemail.net/m/?lang=de") || u.contains("10minutemail.net") ) {
                    String jsGrabEmail =
                            "(function() {" +
                                    "  try {" +
                                    "    var el = document.getElementById('fe_text');" +
                                    "    if (el && el.value) {" +
                                    "      AndroidInterface.showSelectedText(String(el.value));" +
                                    "    }" +
                                    "  } catch(e) {}" +
                                    "})();";
                    view.evaluateJavascript(jsGrabEmail, null);
                }
                if (u.contains("easy-tv.org")) {
                    SharedPreferences prefs = getSharedPreferences("settings", MODE_PRIVATE);
                    String username = prefs.getString("username", "");
                    String password = prefs.getString("password", "");

                    String jsFill = "(function() {" +
                            "var userField = document.querySelector('input[name=\"username\"]');" +
                            "var passField = document.querySelector('input[name=\"password\"]');" +
                            "if(userField) userField.value = '" + username + "';" +
                            "if(passField) passField.value = '" + password + "';" +
                            "})();";

                    view.evaluateJavascript(jsFill, null);
                }
                if (u.contains("easy-tv.org/ucp.php?mode=register")) {
                    SharedPreferences prefs = getSharedPreferences("settings", MODE_PRIVATE);
                    String email = prefs.getString("email", "");

                    String jsFill =
                            "(function() {" +
                                    "var emailField = document.querySelector('input[name=\"email\"]');" +
                                    "if(emailField) emailField.value = '" + email + "';" +
                                    "})();";
                    view.evaluateJavascript(jsFill, null);
                }

                if (u.contains("youtube.com") || u.contains("easy-tv.org")) {

                    String jsAccept = "(function() {" +
                            "var buttons = document.getElementsByTagName('button');" +
                            "for (var i = 0; i < buttons.length; i++) {" +
                            "  var b = buttons[i];" +
                            "  var text = b.innerText.toLowerCase();" +
                            "  if (text.includes('accept') || text.includes('verstanden') || text.includes('alle akzeptieren') || text.includes('zustimmen')) {" +
                            "    b.click();" +
                            "    break;" +
                            "  }" +
                            "}" +
                            "})();";
                    view.evaluateJavascript(jsAccept, null);
                }

                String jsFocus = "(function() {" +
                        "  var inputFields = document.querySelectorAll('input[type=\"text\"], input[type=\"password\"], textarea');" +
                        "  for (var i = 0; i < inputFields.length; i++) {" +
                        "    var field = inputFields[i];" +
                        "    field.classList.add('tv-focusable');" +
                        "    field.setAttribute('tabindex', '0');" +
                        "    field.style.outline = 'none';" +
                        "    field.addEventListener('focus', function(e) {" +
                        "      this.style.boxShadow = '0 0 0 2px #0066cc';" +
                        "    });" +
                        "    field.addEventListener('blur', function(e) {" +
                        "      this.style.boxShadow = 'none';" +
                        "    });" +
                        "  }" +
                        "})();";
                view.evaluateJavascript(jsFocus, null);

                String jsClipboardHook =
                        "(function() {" +
                                "function _safeCopy(t) {" +
                                "  if (window.AndroidInterface && AndroidInterface.showSelectedText) {" +
                                "    AndroidInterface.showSelectedText(String(t));" +
                                "  }" +
                                "}" +
                                "if (!navigator.clipboard) { navigator.clipboard = {}; }" +
                                "navigator.clipboard.writeText = function(t) {" +
                                "  _safeCopy(t);" +
                                "  return Promise.resolve();" +
                                "};" +
                                "window.copyEmailToClipboard = function(t) {" +
                                "  _safeCopy(t);" +
                                "};" +
                                "})();";

                view.evaluateJavascript(jsClipboardHook, null);

                String jsShield = "(function() {" +
                        "  window.open = function() { console.log('PopUp blockiert'); return null; };" +
                        "  document.addEventListener('play', function(e) {" +
                        "    if (e.target && e.target.tagName === 'VIDEO') {" +
                        "      if (window.AndroidInterface && window.AndroidInterface.onVideoDetected) {" +
                        "        window.AndroidInterface.onVideoDetected(e.target.currentSrc || e.target.src || '');" +
                        "      }" +
                        "    }" +
                        "  }, true);" +
                        "  if (" + strictShieldEnabled + ") {" +
                        "    document.querySelectorAll('div[style*=\"z-index\"], iframe[src*=\"ad\"]').forEach(function(el) {" +
                        "      if (el.offsetWidth >= window.innerWidth * 0.85 && el.offsetHeight >= window.innerHeight * 0.85 && !el.querySelector('video')) {" +
                        "        el.remove();" +
                        "      }" +
                        "    });" +
                        "  }" +
                        "})();";
                view.evaluateJavascript(jsShield, null);
            }
        });

        webView.setOnLongClickListener(v -> {
            final WebView.HitTestResult result = webView.getHitTestResult();
            if (result != null &&
                    (result.getType() == WebView.HitTestResult.SRC_ANCHOR_TYPE ||
                            result.getType() == WebView.HitTestResult.SRC_IMAGE_ANCHOR_TYPE)) {

                String u = result.getExtra();
                if (u != null && !u.isEmpty()) {
                    showLinkContextMenu(u, null);
                    return true;
                }
            }
            return false;
        });

        webView.setDownloadListener((u, userAgent, contentDisposition, mimeType, contentLength) -> {
            String fileName = URLUtil.guessFileName(u, contentDisposition, mimeType);
            startFileDownload(u, fileName, contentDisposition, mimeType, userAgent);
        });

        PowerManager powerManager = (PowerManager) getSystemService(Context.POWER_SERVICE);
        wakeLock = powerManager.newWakeLock(
                PowerManager.SCREEN_BRIGHT_WAKE_LOCK | PowerManager.ACQUIRE_CAUSES_WAKEUP,
                "MyApp::WakeLockTag"
        );
        if (wakeLock != null && !wakeLock.isHeld()) {
            wakeLock.acquire();
        }
    }

    public void showLinkContextMenu(String linkUrl, String linkText) {
        if (linkUrl == null || linkUrl.trim().isEmpty()) return;

        String dialogTitle = (linkText != null && !linkText.trim().isEmpty()) ? linkText.trim() : linkUrl;
        if (dialogTitle.length() > 60) {
            dialogTitle = dialogTitle.substring(0, 57) + "...";
        }

        String[] options = new String[]{
                "Link kopieren",
                "Im selben Fenster öffnen",
                "In neuem Fenster öffnen",
                "Zu Favoriten hinzufügen",
                "Link herunterladen",
                "In Easy-TV abspielen"
        };

        new AlertDialog.Builder(this)
                .setTitle(dialogTitle)
                .setItems(options, (dialog, which) -> {
                    switch (which) {
                        case 0: // Link kopieren
                            ClipboardManager clipboard = (ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE);
                            ClipData clip = ClipData.newPlainText("Link", linkUrl);
                            if (clipboard != null) {
                                clipboard.setPrimaryClip(clip);
                            }
                            try {
                                EasyTvDb.get(this).addClipboardEntry(linkUrl);
                            } catch (Exception ignored) {}
                            Toast.makeText(this, "Link in Zwischenablage kopiert", Toast.LENGTH_SHORT).show();
                            break;

                        case 1: // Im selben Fenster öffnen
                            if (webView != null) {
                                webView.loadUrl(linkUrl);
                            }
                            break;

                        case 2: // In neuem Fenster öffnen
                            Intent newTabIntent = new Intent(this, WebActivity.class);
                            newTabIntent.putExtra("url", linkUrl);
                            startActivity(newTabIntent);
                            break;

                        case 3: // Zu Favoriten hinzufügen
                            String favTitle = (linkText != null && !linkText.trim().isEmpty()) ? linkText.trim() : linkUrl;
                            EasyTvDb.get(this).insertFavoriteIfAbsent("", linkUrl, favTitle);
                            try {
                                SQLiteDatabase db = EasyTvDb.get(this).getWritableDatabase();
                                db.execSQL("CREATE TABLE IF NOT EXISTS web_favorites (id INTEGER PRIMARY KEY AUTOINCREMENT, url TEXT UNIQUE NOT NULL, title TEXT, favicon TEXT)");
                                ContentValues cv = new ContentValues();
                                cv.put("url", linkUrl);
                                cv.put("title", favTitle);
                                cv.put("favicon", "");
                                db.insertWithOnConflict("web_favorites", null, cv, SQLiteDatabase.CONFLICT_IGNORE);
                            } catch (Exception ignored) {}
                            Toast.makeText(this, "Zu Favoriten hinzugefügt", Toast.LENGTH_SHORT).show();
                            break;

                        case 4: // Link herunterladen
                            String fileName = URLUtil.guessFileName(linkUrl, null, null);
                            startFileDownload(linkUrl, fileName, null, null, webView != null ? webView.getSettings().getUserAgentString() : null);
                            break;

                        case 5: // In Easy-TV abspielen (JSON-RPC)
                            playMediaInEasyTv(linkUrl);
                            break;
                    }
                })
                .setNegativeButton("Abbrechen", null)
                .show();
    }

    public void playMediaInEasyTv(String mediaUrl) {
        try {
            String cookie = CookieManager.getInstance().getCookie(mediaUrl);
            String userAgent = webView != null ? webView.getSettings().getUserAgentString() : null;

            StringBuilder fullUrl = new StringBuilder(mediaUrl);
            StringBuilder headers = new StringBuilder();

            if (userAgent != null && !userAgent.isEmpty()) {
                headers.append("User-Agent=").append(URLEncoder.encode(userAgent, "UTF-8"));
            }
            if (cookie != null && !cookie.isEmpty()) {
                if (headers.length() > 0) headers.append("&");
                headers.append("Cookie=").append(URLEncoder.encode(cookie, "UTF-8"));
            }

            if (headers.length() > 0) {
                fullUrl.append("|").append(headers.toString());
            }

            String encodedUrl = URLEncoder.encode(fullUrl.toString(), "UTF-8");
            String pluginUrl = "plugin://plugin.autostart/?action=video&url=" + encodedUrl;

            String jsonPayload = "{\"jsonrpc\":\"2.0\",\"method\":\"Player.Open\",\"params\":{\"item\":{\"file\":\"" + pluginUrl + "\"}},\"id\":1}";

            OkHttpClient client = new OkHttpClient();
            RequestBody body = RequestBody.create(jsonPayload, MediaType.parse("application/json; charset=utf-8"));
            Request request = new Request.Builder()
                    .url("http://localhost:8080/jsonrpc")
                    .post(body)
                    .build();

            client.newCall(request).enqueue(new Callback() {
                @Override
                public void onFailure(Call call, IOException e) {
                    runOnUiThread(() -> Toast.makeText(WebActivity.this, "Fehler beim Senden: " + e.getMessage(), Toast.LENGTH_SHORT).show());
                }

                @Override
                public void onResponse(Call call, Response response) {
                    if (response.isSuccessful()) {
                        runOnUiThread(() -> Toast.makeText(WebActivity.this, "In Easy-TV gestartet!", Toast.LENGTH_SHORT).show());
                    } else {
                        runOnUiThread(() -> Toast.makeText(WebActivity.this, "Server-Fehler: " + response.code(), Toast.LENGTH_SHORT).show());
                    }
                }
            });
        } catch (Exception e) {
            Toast.makeText(this, "Fehler: " + e.getMessage(), Toast.LENGTH_SHORT).show();
        }
    }

    public void onVideoDetected(String src) {
        if (!hasDetectedVideo) {
            hasDetectedVideo = true;
            runOnUiThread(() -> Toast.makeText(this, "Video erkannt! Video-Menü verfügbar.", Toast.LENGTH_SHORT).show());
        }
    }

    public void showVideoPlayerMenu() {
        String[] options = new String[]{
                "▶ Start / Play",
                "⏸ Pause / Stop",
                "⏩ 10 Sek. vor-spulen",
                "⏪ 10 Sek. zurück-spulen",
                "⛶ Vollbild umschalten",
                "🛡️ PopUp & Overlay Blocker: " + (strictShieldEnabled ? "EINGESCHALTET" : "AUSGESCHALTET"),
                "❌ Schließen"
        };

        new AlertDialog.Builder(this)
                .setTitle("Videoplayer Steuerungen")
                .setItems(options, (dialog, which) -> {
                    switch (which) {
                        case 0: // Play
                            if (webView != null) {
                                webView.evaluateJavascript("document.querySelectorAll('video').forEach(function(v){ v.play(); });", null);
                            }
                            Toast.makeText(this, "Video gestartet", Toast.LENGTH_SHORT).show();
                            break;
                        case 1: // Pause
                            if (webView != null) {
                                webView.evaluateJavascript("document.querySelectorAll('video').forEach(function(v){ v.pause(); });", null);
                            }
                            Toast.makeText(this, "Video pausiert", Toast.LENGTH_SHORT).show();
                            break;
                        case 2: // Fast forward +10s
                            if (webView != null) {
                                webView.evaluateJavascript("document.querySelectorAll('video').forEach(function(v){ v.currentTime += 10; });", null);
                            }
                            break;
                        case 3: // Rewind -10s
                            if (webView != null) {
                                webView.evaluateJavascript("document.querySelectorAll('video').forEach(function(v){ v.currentTime -= 10; });", null);
                            }
                            break;
                        case 4: // Fullscreen
                            if (webView != null) {
                                webView.evaluateJavascript("var v = document.querySelector('video'); if (v) { if (document.fullscreenElement) { document.exitFullscreen(); } else if (v.requestFullscreen) { v.requestFullscreen(); } else if (v.webkitRequestFullscreen) { v.webkitRequestFullscreen(); } }", null);
                            }
                            break;
                        case 5: // Toggle Strict Shield
                            toggleStrictShield();
                            break;
                    }
                })
                .setNegativeButton("Schließen", null)
                .show();
    }

    public void toggleStrictShield() {
        strictShieldEnabled = !strictShieldEnabled;
        if (webView != null) {
            WebSettings s = webView.getSettings();
            s.setJavaScriptCanOpenWindowsAutomatically(!strictShieldEnabled);
            s.setSupportMultipleWindows(!strictShieldEnabled);
        }
        Toast.makeText(this, "PopUp & Overlay Blocker ist jetzt " + (strictShieldEnabled ? "EINGESCHALTET" : "AUSGESCHALTET"), Toast.LENGTH_SHORT).show();
    }

    private void startApkDownload(String url, String fileName) {
        startFileDownload(url, fileName, null, "application/vnd.android.package-archive", webView != null ? webView.getSettings().getUserAgentString() : null);
    }

    private void startFileDownload(String url, String fileName, String contentDisposition, String mimeType, String userAgent) {
        if (fileName == null || fileName.isEmpty() || fileName.equals("download") || fileName.endsWith(".bin") || fileName.endsWith(".php")) {
            fileName = URLUtil.guessFileName(url, contentDisposition, mimeType);
        }

        Uri uri = Uri.parse(url);
        DownloadManager.Request request = new DownloadManager.Request(uri);

        request.setTitle(fileName);
        request.setDescription("Download läuft...");

        if (mimeType != null && !mimeType.isEmpty() && !mimeType.equals("text/html") && !mimeType.equals("text/plain")) {
            request.setMimeType(mimeType);
        } else {
            String extension = MimeTypeMap.getFileExtensionFromUrl(url);
            if (extension != null && !extension.isEmpty()) {
                String type = MimeTypeMap.getSingleton().getMimeTypeFromExtension(extension);
                if (type != null) {
                    request.setMimeType(type);
                }
            }
        }

        String cookie = CookieManager.getInstance().getCookie(url);
        if (cookie != null && !cookie.isEmpty()) {
            request.addRequestHeader("Cookie", cookie);
        }

        if (userAgent == null || userAgent.isEmpty()) {
            userAgent = webView != null ? webView.getSettings().getUserAgentString() : null;
        }
        if (userAgent != null && !userAgent.isEmpty()) {
            request.addRequestHeader("User-Agent", userAgent);
        }

        request.setNotificationVisibility(DownloadManager.Request.VISIBILITY_VISIBLE_NOTIFY_COMPLETED);
        request.setVisibleInDownloadsUi(true);

        if (Build.VERSION.SDK_INT >= VERSION_CODES.Q) {
            request.setDestinationInExternalFilesDir(this, Environment.DIRECTORY_DOWNLOADS, fileName);
        } else {
            File downloadsDir = Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DOWNLOADS);
            request.setDestinationUri(Uri.fromFile(new File(downloadsDir, fileName)));
        }

        DownloadManager downloadManager = (DownloadManager) getSystemService(DOWNLOAD_SERVICE);
        final long currentDownloadId = downloadManager.enqueue(request);
        downloadId = currentDownloadId;

        progressDialog = new ProgressDialog(this);
        progressDialog.setTitle("Download");
        progressDialog.setMessage("Lade herunter: " + fileName);
        progressDialog.setProgressStyle(ProgressDialog.STYLE_HORIZONTAL);
        progressDialog.setIndeterminate(false);
        progressDialog.setMax(100);
        progressDialog.setCancelable(true);

        progressDialog.setButton(DialogInterface.BUTTON_NEGATIVE, "Abbrechen", (dialog, which) -> {
            try {
                if (downloadManager != null) {
                    downloadManager.remove(currentDownloadId);
                }
            } catch (Exception ignored) {}
            Toast.makeText(WebActivity.this, "Download abgebrochen", Toast.LENGTH_SHORT).show();
        });

        progressDialog.setOnCancelListener(dialog -> {
            try {
                if (downloadManager != null) {
                    downloadManager.remove(currentDownloadId);
                }
            } catch (Exception ignored) {}
            Toast.makeText(WebActivity.this, "Download abgebrochen", Toast.LENGTH_SHORT).show();
        });

        progressDialog.show();

        final String displayFileName = fileName;

        new Thread(() -> {
            boolean downloading = true;
            boolean cancelledOrFailed = false;
            DownloadManager.Query query = new DownloadManager.Query();
            query.setFilterById(currentDownloadId);

            while (downloading) {
                Cursor cursor = downloadManager.query(query);
                if (cursor != null && cursor.moveToFirst()) {
                    int status = cursor.getInt(cursor.getColumnIndexOrThrow(DownloadManager.COLUMN_STATUS));
                    int bytesDownloaded = cursor.getInt(cursor.getColumnIndexOrThrow(
                            DownloadManager.COLUMN_BYTES_DOWNLOADED_SO_FAR));
                    int bytesTotal = cursor.getInt(cursor.getColumnIndexOrThrow(
                            DownloadManager.COLUMN_TOTAL_SIZE_BYTES));

                    if (status == DownloadManager.STATUS_SUCCESSFUL) {
                        downloading = false;
                    } else if (status == DownloadManager.STATUS_FAILED) {
                        downloading = false;
                        cancelledOrFailed = true;
                    }

                    if (bytesTotal > 0 && downloading) {
                        final int progress = (int) ((bytesDownloaded * 100L) / bytesTotal);
                        runOnUiThread(() -> {
                            if (progressDialog != null && progressDialog.isShowing()) {
                                progressDialog.setProgress(progress);
                                double mb = bytesTotal / (1024.0 * 1024.0);
                                progressDialog.setMessage(String.format(
                                        Locale.getDefault(),
                                        "Heruntergeladen: %.1f MB",
                                        mb
                                ));
                            }
                        });
                    }
                    cursor.close();
                } else {
                    downloading = false;
                    cancelledOrFailed = true;
                }

                if (downloading) {
                    try {
                        Thread.sleep(500);
                    } catch (InterruptedException e) {
                        break;
                    }
                }
            }

            final boolean isCancelled = cancelledOrFailed;
            runOnUiThread(() -> {
                if (progressDialog != null && progressDialog.isShowing()) {
                    try {
                        progressDialog.dismiss();
                    } catch (Exception ignored) {}
                }
                if (!isCancelled) {
                    Toast.makeText(this, "Download abgeschlossen: " + displayFileName, Toast.LENGTH_SHORT).show();
                }
            });

        }).start();
    }

    private void updateProgress(int percent) {
        runOnUiThread(() -> {
            if (progressBar != null) {
                progressBar.setProgress(percent);
            }
            if (progressPercent != null) {
                progressPercent.setText(percent + "%");
            }
        });
    }

    @Override
    protected void onNewIntent(Intent intent) {
        super.onNewIntent(intent);


        setIntent(intent);


        String extraUrl = intent.getStringExtra("url");
        if (extraUrl != null && !extraUrl.trim().isEmpty()) {
            webView.loadUrl(extraUrl.trim());
            return;
        }


        if (Intent.ACTION_VIEW.equals(intent.getAction())) {
            Uri uri = intent.getData();
            if (uri != null) {
                webView.loadUrl(uri.toString());
            }
        }
    }


