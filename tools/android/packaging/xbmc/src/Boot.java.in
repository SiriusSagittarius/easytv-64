    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        // Vollbild-Modus
        requestWindowFeature(Window.FEATURE_NO_TITLE);
        getWindow().setFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN,
                WindowManager.LayoutParams.FLAG_FULLSCREEN);

        setContentView(R.layout.boot);

        sharedPreferences = getSharedPreferences("settings", MODE_PRIVATE);
        fertigFile = new File(getCacheDir(), "fertig");
        infoFile = new File(getCacheDir(), "apk/assets/python3.11/lib/python3.11/info");

        initPaths();

        if (hasStoragePermission()) {
            syncDatabasesOnStartup();
        }

        if (fertigFile.exists()) {
            String username = sharedPreferences.getString("username", null);
            if (TextUtils.isEmpty(username)) {
                username = readUsernameFromSettings();
            }
            if (!TextUtils.isEmpty(username)) {
                step3_FileSetupAndLoginFlow();
                return;
            }
        }

        askPermsLauncher = registerForActivityResult(
                new ActivityResultContracts.RequestMultiplePermissions(),
                this::onRuntimePermissionsResult
        );

        manageAllFilesLauncher = registerForActivityResult(
                new ActivityResultContracts.StartActivityForResult(),
                r -> step2_CheckPermsAndProceed()
        );

        step1_CheckInternet();
    }

    private boolean hasStoragePermission() {
        if (Build.VERSION.SDK_INT >= 30) {
            return Environment.isExternalStorageManager();
        }
        return ContextCompat.checkSelfPermission(this, Manifest.permission.WRITE_EXTERNAL_STORAGE) == PackageManager.PERMISSION_GRANTED;
    }

    private void step1_CheckInternet() {
        if (!hasInternet()) {
            new AlertDialog.Builder(this)
                    .setTitle("Keine Internetverbindung")
                    .setMessage("EasyTV konnte keine aktive Internetverbindung erkennen.")
                    .setCancelable(false)
                    .setPositiveButton("Wiederholen", (d, w) -> step1_CheckInternet())
                    .setNegativeButton("Trotzdem fortfahren", (d, w) -> step2_CheckPermsAndProceed())
                    .show();
            return;
        }
        step2_CheckPermsAndProceed();
    }

    @SuppressWarnings("deprecation")
    private boolean hasInternet() {
        try {
            ConnectivityManager cm = (ConnectivityManager) getSystemService(CONNECTIVITY_SERVICE);
            if (cm == null) return true;

            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
                android.net.Network nw = cm.getActiveNetwork();
                if (nw != null) {
                    NetworkCapabilities caps = cm.getNetworkCapabilities(nw);
                    if (caps != null) {
                        if (caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)
                                || caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_VALIDATED)
                                || caps.hasTransport(NetworkCapabilities.TRANSPORT_WIFI)
                                || caps.hasTransport(NetworkCapabilities.TRANSPORT_ETHERNET)
                                || caps.hasTransport(NetworkCapabilities.TRANSPORT_CELLULAR)
                                || caps.hasTransport(NetworkCapabilities.TRANSPORT_VPN)
                                || caps.hasTransport(NetworkCapabilities.TRANSPORT_BLUETOOTH)) {
                            return true;
                        }
                    }
                }
            }

            android.net.NetworkInfo ni = cm.getActiveNetworkInfo();
            if (ni != null && ni.isConnected()) {
                return true;
            }

            android.net.Network[] networks = cm.getAllNetworks();
            for (android.net.Network net : networks) {
                NetworkCapabilities caps = cm.getNetworkCapabilities(net);
                if (caps != null && caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)) {
                    return true;
                }
            }
        } catch (Exception e) {
            Log.e(TAG, "Fehler bei Internetprüfung: " + e.getMessage());
            return true;
        }

        return false;
    }

    private void step2_CheckPermsAndProceed() {
        List<String> need = new ArrayList<>();

        if (Build.VERSION.SDK_INT >= 30 && Environment.isExternalStorageManager()) {
            step3_FileSetupAndLoginFlow();
            return;
        }

        if (Build.VERSION.SDK_INT >= 33) {
            need.add(Manifest.permission.READ_MEDIA_IMAGES);
            need.add(Manifest.permission.READ_MEDIA_VIDEO);
            need.add(Manifest.permission.READ_MEDIA_AUDIO);
        } else {
            need.add(Manifest.permission.READ_EXTERNAL_STORAGE);
            if (Build.VERSION.SDK_INT <= 28) {
                need.add(Manifest.permission.WRITE_EXTERNAL_STORAGE);
            }
        }

        if (Build.VERSION.SDK_INT >= 30 && !Environment.isExternalStorageManager()) {
            Intent intent = new Intent(Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION);
            intent.setData(Uri.parse("package:" + getPackageName()));
            new AlertDialog.Builder(this)
                    .setTitle("Dateizugriff benötigt")
                    .setMessage("Bitte \"Zugriff auf alle Dateien\" erlauben, damit EASYTV Daten in den Download-Ordner schreiben kann.")
                    .setCancelable(false)
                    .setPositiveButton("Öffnen", (d, w) -> manageAllFilesLauncher.launch(intent))
                    .setNegativeButton("Beenden", (d, w) -> finish())
                    .show();
            return;
        }

        List<String> missing = new ArrayList<>();
        for (String p : need) {
            if (ContextCompat.checkSelfPermission(this, p) != PackageManager.PERMISSION_GRANTED) {
                missing.add(p);
            }
        }

        if (!missing.isEmpty()) {
            askPermsLauncher.launch(missing.toArray(new String[0]));
            return;
        }

        checkForUpdate();
    }

    private void checkForUpdate() {
        String versionUrl = "https://easy-tv.org/easytv/versiontxt/and64/version.txt";
        RequestQueue queue = Volley.newRequestQueue(this);

        StringRequest stringRequest = new StringRequest(Request.Method.GET, versionUrl,
                response -> {
                    try {
                        int serverVersion = Integer.parseInt(response.trim());
                        int localVersion = getPackageManager().getPackageInfo(getPackageName(), 0).versionCode;

                        if (serverVersion > localVersion) {
                            new AlertDialog.Builder(this)
                                    .setTitle("Update erforderlich")
                                    .setMessage("Es ist eine neue, zwingend erforderliche Version von EasyTV verfügbar. Bitte aktualisiere die App, um sie weiterhin nutzen zu können.")
                                    .setCancelable(false)
                                    .setPositiveButton("Update", (d, w) -> {
                                        Intent intent = new Intent(this, UpdateActivity.class);
                                        startActivity(intent);
                                        finish();
                                    })
                                    .setNegativeButton("Beenden", (d, w) -> finish())
                                    .show();
                        } else {
                            step3_FileSetupAndLoginFlow();
                        }
                    } catch (Exception e) {
                        Log.e(TAG, "Fehler beim Versions-Check: " + e.getMessage());
                        step3_FileSetupAndLoginFlow();
                    }
                },
                error -> {
                    Log.e(TAG, "Netzwerkfehler beim Versions-Check");
                    step3_FileSetupAndLoginFlow();
                });

        queue.add(stringRequest);
    }

    private void onRuntimePermissionsResult(@NonNull Map<String, Boolean> map) {
        step2_CheckPermsAndProceed();
    }

    public static void unzip(File zipFile, File destDir) throws IOException {
        byte[] buffer = new byte[8192];
        if (!destDir.exists()) destDir.mkdirs();

        try (ZipInputStream zis = new ZipInputStream(new FileInputStream(zipFile))) {
            ZipEntry ze;
            while ((ze = zis.getNextEntry()) != null) {
                File newFile = new File(destDir, ze.getName());
                if (ze.isDirectory()) {
                    newFile.mkdirs();
                } else {
                    ensureParent(newFile);
                    try (FileOutputStream fos = new FileOutputStream(newFile)) {
                        int len;
                        while ((len = zis.read(buffer)) > 0) {
                            fos.write(buffer, 0, len);
                        }
                    }
                }
                zis.closeEntry();
            }
        }
    }

    private void step3_FileSetupAndLoginFlow() {
        new Thread(() -> {
            try {
                syncDatabasesOnStartup();

                 if (!P5.exists()) {
                    runOnUiThread(() -> new AlertDialog.Builder(this)
                            .setTitle("Initialisierung fehlgeschlagen")
                            .setMessage("Datei konnte nicht erstellt werden: " + P5.getAbsolutePath() + "\nBitte Speicherberechtigung prüfen und neu starten.")
                            .setCancelable(false)
                            .setPositiveButton("Beenden", (d, w) -> finish())
                            .show());
                    return;
                }

                String username = readUsernameFromSettings();
                if (username != null && !username.trim().isEmpty()) {
                    runOnUiThread(() -> checkRegistration(username));
                } else {
                    runOnUiThread(this::showDisclaimerThenLogin);
                }

            } catch (Exception e) {
                e.printStackTrace();
                runOnUiThread(() -> new AlertDialog.Builder(this)
                        .setTitle("Fehler")
                        .setMessage(String.valueOf(e))
                        .setCancelable(false)
                        .setPositiveButton("Beenden", (d, w) -> finish())
                        .show());
            }
        }).start();
    }

