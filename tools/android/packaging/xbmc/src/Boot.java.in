    private void copyDir(File srcDir, File dstDir) throws IOException {
        if (!srcDir.exists()) return;
        if (srcDir.isFile()) {
            ensureParent(dstDir);
            copyFile(srcDir, dstDir);
            return;
        }
        if (!dstDir.exists()) dstDir.mkdirs();
        File[] files = srcDir.listFiles();
        if (files == null) return;
        for (File file : files) {
            File dest = new File(dstDir, file.getName());
            copyDir(file, dest);
        }
    }


    private void syncDatabasesOnStartup() {
        try {
            File downloads = Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_DOWNLOADS);
            File extBase = new File(downloads, "EASYTV/data");
            File intBase = new File(getApplicationInfo().dataDir);

            File intDbDir = new File(intBase, "databases");
            File intFilesDir = new File(intBase, "files");
            File intPrefsDir = new File(intBase, "shared_prefs");

            File extDbDir = new File(extBase, "databases");
            File extFilesDir = new File(extBase, "files");
            File extPrefsDir = new File(extBase, "shared_prefs");

            File intEasy = new File(intDbDir, "easytv.db");
            File intYT = new File(intDbDir, "youtube.db");
            File extEasy = new File(extDbDir, "easytv.db");
            File extYT = new File(extDbDir, "youtube.db");

            boolean internalMissing = !intEasy.exists() || !intYT.exists();
            boolean externalMissing = !extEasy.exists() || !extYT.exists();

            if (internalMissing && externalMissing) {
                Log.i("BOOT", "Keine Daten gefunden (Neuinstallation). Starte Installation aus dat.zip...");

                if (!downloads.exists()) downloads.mkdirs();

                File zipFile = new File(downloads, "dat.zip");
                copyRawToFile(R.raw.dat, zipFile);

                unzip(zipFile, downloads);

                if (zipFile.exists()) zipFile.delete();

                Log.i("BOOT", "dat.zip erfolgreich entpackt.");

                externalMissing = false;
            }

            if (!extBase.exists()) {
                extBase.mkdirs();
            }

           if (internalMissing && !externalMissing) {
                if (extBase.exists()) {
                    copyDir(extDbDir, intDbDir);
                    copyDir(extFilesDir, intFilesDir);
                    copyDir(extPrefsDir, intPrefsDir);
                    Log.i("BOOT", "Daten von SD-Karte wiederhergestellt (Restore).");
                }
            }

            // 3. FALL: Backup
            // Intern sind Daten da -> Sichern nach Extern (damit beim nächsten Mal Restore klappt)
            else if (!internalMissing) {
                copyDir(intDbDir, extDbDir);
                copyDir(intFilesDir, extFilesDir);
                copyDir(intPrefsDir, extPrefsDir);
                Log.i("BOOT", "Sicherheitskopie auf SD-Karte erstellt (Backup).");
            }

        } catch (Exception e) {
            Log.e("BOOT", "Fehler bei syncDatabasesOnStartup(): " + e.getMessage(), e);
        }
    }

    private void copyFile(File src, File dst) throws IOException {
        if (!src.exists()) return;


        ensureParent(dst);

        try (FileInputStream in = new FileInputStream(src);
             FileOutputStream out = new FileOutputStream(dst)) {
            byte[] buffer = new byte[4096];
            int len;
            while ((len = in.read(buffer)) > 0) {
                out.write(buffer, 0, len);
            }
        }
    }

    private void authenticateUser(String username, String password) {
        String url = "https://easy-tv.org/api2.php?username=" + username + "&password=" + password;
        RequestQueue queue = Volley.newRequestQueue(this);

        StringRequest request = new StringRequest(Request.Method.GET, url, response -> {
            try {
                JSONObject obj = new JSONObject(response);
                if ("authenticated".equals(obj.getString("status"))) {
                    sharedPreferences.edit()
                            .putString("username", username)
                            .putString("password", password)
                            .apply();
                    try { if (!fertigFile.exists()) fertigFile.createNewFile(); } catch (IOException ignored) {}

                    goToSplash();

                } else {
                    Toast.makeText(this, "Authentifizierung fehlgeschlagen.", Toast.LENGTH_SHORT).show();
                }
            } catch (JSONException e) {
                e.printStackTrace();
            }
        }, error -> Toast.makeText(this, "Netzwerkfehler.", Toast.LENGTH_SHORT).show());

        queue.add(request);
    }

    private void checkRegistration(String username) {
        String url = "https://easy-tv.org/api1.php?username=" + Uri.encode(username);
        RequestQueue queue = Volley.newRequestQueue(this);

        StringRequest request = new StringRequest(Request.Method.GET, url, response -> {
            try {
                JSONObject obj = new JSONObject(response);
                if ("registered".equals(obj.optString("status"))) {
                    if (!fertigFile.exists()) {
                        try {
                            fertigFile.createNewFile();
                        } catch (IOException e) {
                            throw new RuntimeException(e);
                        }
                    }
                    checkOnlineStatus(username);
                } else {
                    sharedPreferences.edit().remove("username").apply();
                    showDisclaimerThenLogin();
                }
            } catch (JSONException e) {
                e.printStackTrace();
            }
        }, error -> {
            Toast.makeText(this, "Netzwerkfehler.", Toast.LENGTH_SHORT).show();
        });

        queue.add(request);
    }

    private void checkOnlineStatus(String username) {
        String url = "https://easy-tv.org/is_online.php?username=" + Uri.encode(username);
        RequestQueue queue = Volley.newRequestQueue(this);

        StringRequest request = new StringRequest(Request.Method.GET, url, response -> {
            try {
                JSONObject obj = new JSONObject(response);
                boolean isOnline = obj.optBoolean("online", false);

                if (isOnline) {
                    goToSplash();
                } else {
                    goToAdwebview();
                }
            } catch (JSONException e) {
                e.printStackTrace();
                goToAdwebview();
            }
        }, error -> goToAdwebview());

        queue.add(request);
    }

    static void ensureParent(File f) {
        File parent = f.getParentFile();
        if (parent != null && !parent.exists()) {
            parent.mkdirs();
        }
    }

    private void copyRawToFile(int rawId, File dst) throws IOException {
        ensureParent(dst);
        try (InputStream in = getResources().openRawResource(rawId);
             OutputStream out = new FileOutputStream(dst)) {
            byte[] buf = new byte[8192];
            int n;
            while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
        }
    }

    private void goToSplash() {
        Intent i = new Intent(this, Splash.class);
        i.putExtra("from", "boot");
        startActivity(i);
        finish();
    }

    private void goToAdwebview() {
        Intent i = new Intent(this, Adwebview.class);
        i.putExtra("from", "boot");
        startActivity(i);
        finish();
    }

    private String readUsernameFromSettings() {
        try {
            SharedPreferences sp = getSharedPreferences("settings", MODE_PRIVATE);
            if (sp.contains("username")) {
                return sp.getString("username", null);
            }
        } catch (Exception ignored) {
        }
        if (P4 != null && P4.exists()) {
            try (BufferedReader br = new BufferedReader(new FileReader(P4))) {
                String line;
                while ((line = br.readLine()) != null) {
                    int i = line.indexOf("name=\"username\"");
                    if (i >= 0) {
                        int s = line.indexOf('>', i);
                        int e = line.indexOf("</string>", s + 1);
                        if (s > 0 && e > s) {
                            return line.substring(s + 1, e).trim();
                        }
                    }
                }
            } catch (IOException ignored) {
            }
        }
        return null;
    }

    private boolean isTV() {
        return (getResources().getConfiguration().uiMode & Configuration.UI_MODE_TYPE_MASK) == Configuration.UI_MODE_TYPE_TELEVISION;
    }

    private int dp(int px) {
        float density = getResources().getDisplayMetrics().density;
        return Math.round(px * density);
    }

    @Override
    protected void onResume() {
        super.onResume();
        // Permission check, bevor wir syncen, um Crashes zu vermeiden
        if (hasStoragePermission()) {
            syncDatabasesOnStartup();
        }

        SharedPreferences prefs = getSharedPreferences("settings", MODE_PRIVATE);
        String savedUsername = prefs.getString("username", null);
        String savedPassword = prefs.getString("password", null);

        if (editText1 != null && savedUsername != null) {
            editText1.setText(savedUsername);
        }
        if (editText2 != null && savedPassword != null) {
            editText2.setText(savedPassword);
        }

        username = savedUsername;
        password = savedPassword;
    }
}