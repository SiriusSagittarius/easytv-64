package app.easytv.org;

import android.app.AlertDialog;
import android.content.ClipData;
import android.content.ClipboardManager;
import android.content.Context;
import android.content.Intent;
import android.database.Cursor;
import android.os.Bundle;
import android.view.*;
import android.widget.*;
import androidx.appcompat.app.AppCompatActivity;

import com.bumptech.glide.Glide;

import java.util.ArrayList;
import java.util.List;

import app.easytv.org.data.EasyTvDb;

public class HistoryList extends AppCompatActivity {

    private ListView listView;
    private final List<HistoryItem> historyList = new ArrayList<>();
    private HistoryAdapter adapter;
    private EasyTvDb db;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_history_list);
        setTitle("Verlauf");

        db = EasyTvDb.get(this);
        listView = findViewById(R.id.historyListView);

        adapter = new HistoryAdapter();
        listView.setAdapter(adapter);
        listView.setOnItemClickListener((p, v, pos, id) -> showOptionsDialog(historyList.get(pos)));
        reload();



    }

    private void reload() {
        historyList.clear();
        try (Cursor c = db.getHistoryDesc()) {
            int ixId = c.getColumnIndexOrThrow("id");
            int ixFav = c.getColumnIndexOrThrow("favicon");
            int ixUrl = c.getColumnIndexOrThrow("url");
            int ixTitle = c.getColumnIndexOrThrow("titel");
            while (c.moveToNext()) {
                historyList.add(new HistoryItem(
                        c.getLong(ixId),
                        c.getString(ixUrl),
                        c.getString(ixTitle),
                        c.getString(ixFav)));
            }
        }
        adapter.notifyDataSetChanged();
        if (historyList.isEmpty()) {
            Toast.makeText(this, "Kein Verlauf vorhanden", Toast.LENGTH_SHORT).show();
        }
    }

    private void showOptionsDialog(HistoryItem item) {
        String[] options = {"OPEN", "ADD FAVOS", "CLIPBOARD", "DELETE", "CLEAN HISTORY"};
        new AlertDialog.Builder(this)
                .setTitle("Optionen")
                .setItems(options, (d, which) -> {
                    switch (which) {
                        case 0: openUrlInWebView(item.getUrl()); break;
                        case 1:
                            db.upsertFavorite(item.getFaviconUrl(), item.getUrl(), item.getTitle());
                            Toast.makeText(this, "In Favoriten gespeichert", Toast.LENGTH_SHORT).show();
                            break;
                        case 2:
                            copyToClipboardAndDb(item.getUrl());
                            break;
                        case 3:
                            db.deleteHistoryItem(item.getId());
                            reload();
                            break;
                        case 4:
                            db.clearHistory();
                            reload();
                            break;
                    }
                })
                .show();
    }

    private void copyToClipboardAndDb(String url) {
        ClipboardManager cb = (ClipboardManager) getSystemService(Context.CLIPBOARD_SERVICE);
        if (cb != null) {
            cb.setPrimaryClip(ClipData.newPlainText("URL", url));
        }
        db.addClipboardEntry(url);
        Toast.makeText(this, "Im Clipboard gespeichert", Toast.LENGTH_SHORT).show();
    }

    private void openUrlInWebView(String url) {
        Intent intent = new Intent(this, WebActivity.class);
        intent.putExtra("url", url);
        startActivity(intent);
    }

    /* ---------- Adapter ---------- */
    private class HistoryAdapter extends BaseAdapter {
        @Override public int getCount() { return historyList.size(); }
        @Override public HistoryItem getItem(int pos) { return historyList.get(pos); }
        @Override public long getItemId(int pos) { return historyList.get(pos).getId(); }
        @Override public View getView(int position, View convertView, ViewGroup parent) {
            View v = convertView;
            VH h;
            if (v == null) {
                v = getLayoutInflater().inflate(R.layout.history_list_item, parent, false);
                h = new VH(v);
                v.setTag(h);
            } else {
                h = (VH) v.getTag();
            }
            HistoryItem it = getItem(position);
            h.title.setText(it.getTitle() != null ? it.getTitle() : it.getUrl());
            h.url.setText(it.getUrl());
            if (it.getFaviconUrl() != null && !it.getFaviconUrl().isEmpty()) {
                Glide.with(HistoryList.this).load(it.getFaviconUrl()).into(h.favicon);
            } else {
                h.favicon.setImageDrawable(null);
            }
            return v;
        }

        class VH {
            final ImageView favicon; final TextView title; final TextView url;
            VH(View v) {
                favicon = v.findViewById(R.id.faviconImageView);
                title   = v.findViewById(R.id.titleTextView);
                url     = v.findViewById(R.id.urlTextView);
            }
        }
    }
}
