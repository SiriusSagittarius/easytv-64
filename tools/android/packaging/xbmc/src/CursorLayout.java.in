    @Override
    public boolean onTouchEvent(MotionEvent event) {
        if (event.getAction() == MotionEvent.ACTION_MOVE) {
            return false;
        }


        if (event.getAction() == MotionEvent.ACTION_DOWN || event.getAction() == MotionEvent.ACTION_UP) {

            float x = event.getX();
            float y = event.getY();


            MotionEvent webViewEvent = MotionEvent.obtain(event.getDownTime(), event.getEventTime(), event.getAction(), x, y, event.getMetaState());

            if (webView != null) {
                webView.dispatchTouchEvent(webViewEvent);
            }
            return true;
        }

        return super.onTouchEvent(event);
    }

