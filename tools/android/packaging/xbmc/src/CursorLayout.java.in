    private void checkHoverState() {
        if (webView == null) return;
        long now = System.currentTimeMillis();
        if (now - lastHoverCheckTime < 100) return;
        lastHoverCheckTime = now;

        float x = cursorPosition.x;
        float y = cursorPosition.y;

        String js = String.format(Locale.US,
            "(function() {" +
            "  var el = document.elementFromPoint(%f, %f);" +
            "  if (!el) return JSON.stringify({clickable:false});" +
            "  var a = el.closest('a');" +
            "  var t = el.closest('a, button, input, select, textarea, [onclick], [role=\"button\"]');" +
            "  return JSON.stringify({" +
            "    clickable: (t !== null || a !== null)," +
            "    href: a ? a.href : null," +
            "    text: t ? (t.innerText || t.value || '') : (a ? (a.innerText || '') : '')" +
            "  });" +
            "})()", x, y);

        webView.post(() -> webView.evaluateJavascript(js, value -> {
            if (value == null || value.equals("null") || value.equals("\"null\"")) {
                isHoveringClickable = false;
                currentHoverUrl = null;
                currentHoverText = null;
                return;
            }
            try {
                String unquoted = value;
                if (unquoted.startsWith("\"") && unquoted.endsWith("\"")) {
                    unquoted = unquoted.substring(1, unquoted.length() - 1)
                            .replace("\\\"", "\"")
                            .replace("\\\\", "\\");
                }
                org.json.JSONObject obj = new org.json.JSONObject(unquoted);
                boolean hovering = obj.optBoolean("clickable", false);
                String href = obj.optString("href", null);
                if ("null".equals(href) || href.trim().isEmpty()) {
                    href = null;
                }
                String text = obj.optString("text", "");

                if (isHoveringClickable != hovering || !Objects.equals(currentHoverUrl, href)) {
                    isHoveringClickable = hovering;
                    currentHoverUrl = href;
                    currentHoverText = text;
                    invalidate();
                }
            } catch (Exception e) {
                isHoveringClickable = false;
                currentHoverUrl = null;
                currentHoverText = null;
            }
        }));
    }

