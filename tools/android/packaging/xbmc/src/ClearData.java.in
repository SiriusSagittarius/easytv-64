package app.easytv.org;

import android.content.Context;
import android.webkit.CookieManager;

import java.io.File;
import java.io.FileOutputStream;
public class ClearData {

    public static void clearAll(Context context) {


        CookieManager.getInstance().removeAllCookies(null);
        CookieManager.getInstance().flush();



        deleteDir(context.getCacheDir());
        deleteDir(context.getExternalCacheDir());



        File base = new File(context.getFilesDir(), "easy");
        deleteFileOrDir(new File(base, "verlauf"));
        deleteFileOrDir(new File(base, "pastlist"));


        if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.N) {
            File cookies = new File(context.getDataDir(), "app_webview/Cookies");
            deleteFileOrDir(cookies);
        }
    }

    private static void deleteFileOrDir(File file) {
        if (file != null && file.exists()) {
            if (file.isDirectory()) {
                deleteDir(file);
            } else {

                if (!file.delete()) {
                    try {
                        new FileOutputStream(file).close();
                        file.delete();
                    } catch (Exception ignored) {}
                }
            }
        }
    }

    private static boolean deleteDir(File dir) {
        if (dir != null && dir.exists()) {
            File[] children = dir.listFiles();
            if (children != null) {
                for (File child : children) {
                    deleteFileOrDir(child);
                }
            }
            return dir.delete();
        }
        return false;
    }
}