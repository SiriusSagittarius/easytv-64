<window>
    <controls>
        <control type="image">
            <left>0</left><top>0</top>
            <width>1920</width><height>1080</height>
            <texture colordiffuse="202020ff">white.png</texture>
        </control>

        <control type="label">
            <left>60</left><top>40</top>
            <width>1800</width><height>60</height>
            <font>font36_title</font>
            <label>YTGrid – Ergebnisse</label>
            <textcolor>FFFFFFFF</textcolor>
        </control>

        <control type="panel" id="1000">
            <left>60</left><top>120</top>
            <width>1800</width><height>900</height>
            <viewtype label="Grid">icon</viewtype>
            <pagecontrol>60</pagecontrol>
            <scrolltime>200</scrolltime>

            <itemlayout width="330" height="280">
                <control type="image">
                    <left>0</left><top>0</top>
                    <width>320</width><height>180</height>
                    <texture>$INFO[ListItem.Art(thumb)]</texture>
                    <aspectratio>scale</aspectratio>
                </control>
                <control type="label">
                    <left>0</left><top>190</top>
                    <width>320</width><height>60</height>
                    <font>font13</font>
                    <label>$INFO[ListItem.Label]</label>
                    <wrapmultiline>true</wrapmultiline>
                    <textcolor>FFFFFFFF</textcolor>
                </control>
                <control type="label">
                    <left>0</left><top>255</top>
                    <width>120</width><height>24</height>
                    <font>font12</font>
                    <label>$INFO[ListItem.Label2]</label>
                    <textcolor>FFAAAAAA</textcolor>
                </control>
            </itemlayout>

            <focusedlayout width="330" height="280">
                <control type="image">
                    <left>-6</left><top>-6</top>
                    <width>332</width><height>192</height>
                    <texture colordiffuse="40FFFFFF">white.png</texture>
                </control>
                <control type="image">
                    <left>0</left><top>0</top>
                    <width>320</width><height>180</height>
                    <texture>$INFO[ListItem.Art(thumb)]</texture>
                    <aspectratio>scale</aspectratio>
                </control>
                <control type="label">
                    <left>0</left><top>190</top>
                    <width>320</width><height>60</height>
                    <font>font13_title</font>
                    <label>$INFO[ListItem.Label]</label>
                    <wrapmultiline>true</wrapmultiline>
                    <textcolor>FFFFFFFF</textcolor>
                </control>
                <control type="label">
                    <left>0</left><top>255</top>
                    <width>120</width><height>24</height>
                    <font>font12</font>
                    <label>$INFO[ListItem.Label2]</label>
                    <textcolor>FFFFFFFF</textcolor>
                </control>
            </focusedlayout>
        </control>

        <control type="scrollbar" id="60">
            <visible>false</visible>
            <left>0</left><top>0</top>
            <width>0</width><height>0</height>
        </control>
    </controls>
</window>
